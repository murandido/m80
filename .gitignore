
# Frontend (Node / Next.js / pnpm)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# NPM / Yarn / pnpm Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/bin/
backend/tmp/

# Test and Coverage
*.test
*.out
*.coverprofile
profile.cov
coverage.*

# Go Workspaces
go.work
go.work.sum

# Environment & Secrets
.env
.env.*
!.env.sample
*.pem
*.key

# OS & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Database dumps (db-backup.sh defaults to /var/backups, but BACKUP_DIR is overridable)
backups/
*.dump

# Which image tag is live on a given machine - per-host state, not source
deploy/.deploy-state
