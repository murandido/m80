# One domain serves both halves of the product now that the panel runs on this
# box instead of Vercel. The site is the panel; the Go API is not published at
# all - its only client is frontend-prod, over the Compose network - with a
# single exception for the health path the deploy script checks from outside.
#
# That is why CORS_ALLOWED_ORIGINS_PROD can stay empty for good: the browser is
# no longer merely uninterested in calling the API directly, it has no address
# to call.

# www only exists to land on the bare domain, so the session cookie (which is
# per hostname) always lives on one name. Every machine using this file needs a
# www record too: without it Caddy retries this certificate forever and burns
# the Let's Encrypt failure quota.
www.{$API_DOMAIN} {
	redir https://{$API_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	encode gzip

	header {
		# The panel is HTTPS-only from day one, so there is no grace period to
		# preserve by leaving this short.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Nothing downstream needs to know which server this is.
		-Server
	}

	# deploy/vps-deploy.sh health-checks https://$API_DOMAIN/health from the
	# public internet, hairpinning back in, so this one path stays wired to the
	# API. It is also the only request the API still receives through a proxy,
	# which is what middleware.RealIP and TRUSTED_PROXY were configured for.
	handle /health {
		reverse_proxy api-prod:8080
	}

	handle {
		reverse_proxy frontend-prod:3000 {
			# The panel proxies an SSE stream at /api/events, and it must arrive
			# frame by frame. Caddy already disables buffering for
			# text/event-stream, and this makes it explicit: a proxy that buffers
			# kills every live update in the panel with no error anywhere - just
			# screens that quietly stop moving.
			flush_interval -1
		}
	}
}

# Other projects on this box publish through this same Caddy instead of running
# a second one, which could not bind 80/443. Each drops one <name>.caddy file
# into /opt/caddy-sites on the host (mounted read-only here), so adding a site
# never means editing this file. An empty directory is fine: the glob simply
# matches nothing.
import /etc/caddy/sites/*.caddy
