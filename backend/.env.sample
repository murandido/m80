AZUL_LOGIN_PROXY_USER_PROD=""
AZUL_LOGIN_PROXY_PASS_PROD=""
# The same browser service asks Smiles to send the verification code (backend/carriers).
SMILES_LOGIN_SERVICE_URL_PROD="http://azul-login-service-prod:8083"
SMILES_CHALLENGE_MAX_ATTEMPTS_PROD=6
SMILES_CHALLENGE_ATTEMPT_TIMEOUT_SECONDS_PROD=60
SMILES_CHALLENGE_WARMUP_SECONDS_PROD=12
ENCRYPTION_KEY_PROD=""
# Blind index for CPFs (openssl rand -hex 32). Losing it orphans every stored
# fingerprint, so it belongs in the backup alongside ENCRYPTION_KEY.
CPF_INDEX_KEY_PROD=""
BOT_INTERNAL_URL_PROD="http://whatsapp-bot-prod:8081"
BOT_STATUS_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/status-changed"
BOT_CHAT_REQUESTED_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/chat-requested"
BOT_ISSUANCE_CREATED_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/issuance-created"
BOT_ISSUANCE_UPDATED_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/issuance-updated"
BOT_ISSUANCE_CANCELLED_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/issuance-cancelled"
BOT_ISSUANCE_DELETED_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/issuance-deleted"
BOT_PROMO_ENROLLED_CALLBACK_URL_PROD="http://api-prod:8090/internal/bot/promo-enrolled"
TRAVEOS_BASE_URL_PROD="https://prd.traveos.com.br/api"
TRAVEOS_EMAIL_PROD=""
TRAVEOS_PASSWORD_PROD=""
# The first admin, created only while the users table is still empty. Leave them
# blank and the API boots with no user at all - deliberately, so production
# never inherits the fixed development credentials.
ADMIN_PHONE_PROD=""
ADMIN_PASSWORD_PROD=""
# Leave empty, permanently. The panel is served from the same host as this API
# and the API is not published to the internet at all, so there is no cross-site
# origin left to allow.
CORS_ALLOWED_ORIGINS_PROD=""
# The single hostname Caddy serves and requests a certificate for, e.g.
# "m80.exemplo.com.br". Its A record has to resolve to this box before the first
# start, or Let's Encrypt fails in a loop and burns the rate limit.
#
# The name is narrower than the job: since the panel moved off Vercel this one
# domain serves the panel, and routes only /health to the API. Renaming it would
# mean touching vps-deploy.sh, the Caddyfile, this file and every deployed .env
# at once, which is not worth the churn.
API_DOMAIN_PROD=""

# The Azul browser container has no DNS override: it inherits the host's resolver, so it tracks
# whatever network the machine is on. (A hardcoded resolver broke on network changes - a stale LAN
# resolver is unreachable, a public one is blocked on networks that filter port 53.)

# Tuning for the Azul login service; the defaults are the measured ones. See backend/carriers.
AZUL_LOGIN_CURSOR_MAX_SECONDS_DEV=
AZUL_LOGIN_CURSOR_MAX_SECONDS_PROD=

AZUL_LOGIN_FLIGHT_WARMUP_MODE_DEV=full
AZUL_LOGIN_FLIGHT_WARMUP_MODE_PROD=full

# A failed login is retried up to MAX_ATTEMPTS times, spaced by RETRY_BACKOFF_SECONDS * attempt,
# and each attempt is bounded by ATTEMPT_TIMEOUT_SECONDS.
AZUL_LOGIN_MAX_ATTEMPTS_DEV=3
AZUL_LOGIN_MAX_ATTEMPTS_PROD=3
AZUL_LOGIN_RETRY_BACKOFF_SECONDS_DEV=15
AZUL_LOGIN_RETRY_BACKOFF_SECONDS_PROD=15
AZUL_LOGIN_ATTEMPT_TIMEOUT_SECONDS_DEV=150
AZUL_LOGIN_ATTEMPT_TIMEOUT_SECONDS_PROD=150

# Azul read client (balance + statement sync). Where the values come from is documented in
# backend/carriers. Without them the sync cannot run.
AZUL_FIREBASE_API_KEY_DEV=
AZUL_FIREBASE_API_KEY_PROD=
AZUL_FIREBASE_APP_ID_DEV=
AZUL_FIREBASE_APP_ID_PROD=
AZUL_FIREBASE_PROJECT_ID_DEV=
AZUL_FIREBASE_PROJECT_ID_PROD=
AZUL_FIREBASE_PROJECT_NUMBER_DEV=
AZUL_FIREBASE_PROJECT_NUMBER_PROD=

# Blank uses the client's default.
AZUL_USER_AGENT_DEV=
AZUL_USER_AGENT_PROD=

# The periodic sync ticker. "false" keeps it off; the first sync on connect runs regardless.
# AZUL_SYNC_INTERVAL is a Go duration (e.g. "10m"); blank uses the default.
AZUL_SYNC_ENABLED_DEV=false
AZUL_SYNC_ENABLED_PROD=false
AZUL_SYNC_INTERVAL_DEV=
AZUL_SYNC_INTERVAL_PROD=

# Avianca booking lookup (backend/carriers). Blank leaves the Avianca integration
# unregistered. Needed by the API and the bot.
AVIANCA_GUEST_TOKEN_DEV=
AVIANCA_GUEST_TOKEN_PROD=
AVIANCA_SUBSCRIPTION_KEY_DEV=
AVIANCA_SUBSCRIPTION_KEY_PROD=

# Optional egress proxy for the LATAM and Air France booking lookups, as http://host:port or
# http://user:password@host:port. Blank dials directly. Needed by the API and the bot.
LATAM_PROXY_URL_DEV=
LATAM_PROXY_URL_PROD=
AIRFRANCE_PROXY_URL_DEV=
AIRFRANCE_PROXY_URL_PROD=

# Smiles: nothing secret to fill in. A round runs on the session the account itself stored when
# an operator connected it with a verification code, so there is no key here that can be missing.
# Blank uses the client's default.
SMILES_USER_AGENT_DEV=
SMILES_USER_AGENT_PROD=

# Egress for every Smiles call (API reads and the browser that asks for the code). Production
# needs the credentialed residential URL; provider parameters go in the password, e.g.
# ...:PASS_country-br_session-<id>_lifetime-10m@host:port. Blank goes direct.
SMILES_PROXY_URL_DEV=
SMILES_PROXY_URL_PROD=

# The periodic sync ticker. "false" keeps it off; the first sync on connect runs regardless.
# SMILES_SYNC_INTERVAL is a Go duration (e.g. "10m"); blank uses the default.
SMILES_SYNC_ENABLED_DEV=false
SMILES_SYNC_ENABLED_PROD=false
SMILES_SYNC_INTERVAL_DEV=
SMILES_SYNC_INTERVAL_PROD=
