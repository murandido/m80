DB_USER_DEV=""
DB_PASSWORD_DEV=""
DB_NAME_DEV=""
DB_HOST_DEV=""
DB_PORT_DEV=""
JWT_SECRET_DEV=""
PDF_SERVICE_URL_DEV="http://pdf-service-dev:5000"
# Headless-browser service that enrols CPFs in transfer-bonus promotions.
PROMO_SERVICE_URL_DEV="http://promo-service-dev:8082"
# Service that connects an Azul account. Documented in backend/carriers (private submodule).
AZUL_LOGIN_SERVICE_URL_DEV="http://azul-login-service-dev:8083"
AZUL_LOGIN_PROXY_DEV=""
AZUL_LOGIN_PROXY_USER_DEV=""
AZUL_LOGIN_PROXY_PASS_DEV=""
# The same browser service asks Smiles to send the verification code (backend/carriers).
SMILES_LOGIN_SERVICE_URL_DEV="http://azul-login-service-dev:8083"
SMILES_CHALLENGE_MAX_ATTEMPTS_DEV=6
SMILES_CHALLENGE_ATTEMPT_TIMEOUT_SECONDS_DEV=60
SMILES_CHALLENGE_WARMUP_SECONDS_DEV=12
ENCRYPTION_KEY_DEV=""
# Blind index for CPFs (openssl rand -hex 32). Losing it orphans every stored
# fingerprint, so it belongs in the backup alongside ENCRYPTION_KEY.
CPF_INDEX_KEY_DEV=""
BOT_INTERNAL_URL_DEV="http://whatsapp-bot-dev:8081"
BOT_STATUS_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/status-changed"
BOT_CHAT_REQUESTED_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/chat-requested"
BOT_ISSUANCE_CREATED_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/issuance-created"
BOT_ISSUANCE_UPDATED_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/issuance-updated"
BOT_ISSUANCE_CANCELLED_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/issuance-cancelled"
BOT_ISSUANCE_DELETED_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/issuance-deleted"
BOT_PROMO_ENROLLED_CALLBACK_URL_DEV="http://api-dev:8090/internal/bot/promo-enrolled"
TRAVEOS_BASE_URL_DEV="https://prd.traveos.com.br/api"
TRAVEOS_EMAIL_DEV=""
TRAVEOS_PASSWORD_DEV=""
# Comma separated. Empty allows no cross-site origin at all, which is enough for
# the panel to work: the browser never calls this API directly, only the Next.js
# server does, and server-to-server requests carry no Origin.
CORS_ALLOWED_ORIGINS_DEV="http://localhost:3000"

