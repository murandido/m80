{{- /*
The ticket, in the subset WeasyPrint 61.2 renders.

Four rules this file has to keep, because the same string is both the page the
panel shows and the input the PDF service is handed:

  1. NO CSS GRID. WeasyPrint 61.2 does not implement it at all - a grid degrades
     to stacked blocks with no warning, so the five-column flight segment is
     `display: table` instead. Flexbox is only partly implemented; it is used
     for simple rows and never load-bearing.
  2. NO oklch(), no color-mix(), no @media. All three parse as invalid and the
     declaration is dropped, so a colour written that way renders as black.
  3. Only fonts the pdf-service container has, which is fonts-liberation. The
     original page uses Articulat CF (commercial, cannot be embedded), so the
     stack is Liberation Sans with the system stack behind it - metrically close,
     and the fallback is what the browser uses on the panel anyway.
  4. EVERY inline SVG carries an explicit colour. `currentColor` in an SVG
     presentation attribute is not resolved by WeasyPrint's SVG renderer, and
     the icon silently disappears - which is why the plane in the journey header
     was invisible in the PDF while being perfectly there in the markup. The Go
     side already computes Brand and BrandOn, so the hex is interpolated
     straight into the attribute. Do not "simplify" these back to currentColor.

The page is 216mm wide - the vendor's own width - with a height computed from
the content in Go, so the ticket lands on one page instead of being sliced by a
paper size that knows nothing about it. See pageHeightMM in ticket.go.

The spacing ruler is 3.5px, from the original design, scaled to the 188mm
content column: 7, 10, 14, 18, 21, 25, 28.
*/ -}}
{{- /*
The icons are filled silhouettes, never stroked outlines. WeasyPrint 61.2 draws
a 1.8px stroke on a 15px icon as a smudge, while a fill comes out crisp at any
size. Each takes its colour as the dot, because an SVG presentation attribute
cannot read currentColor here (see rule 4 above).
*/ -}}
{{- define "planeIcon" -}}
<svg class="{{ .Class }}" viewBox="0 0 24 24">{{ if .Inbound }}<g transform="translate(24,0) scale(-1,1)">{{ else }}<g>{{ end }}<path fill="{{ .Colour }}" d="M22 12c0-.6-.4-1-1-1h-4.5L11 3.5c-.2-.3-.5-.5-.9-.5H8l3 8H6.5L4 8H2l1.5 4L2 16h2l2.5-3H11l-3 8h2.1c.4 0 .7-.2.9-.5L16.5 13H21c.6 0 1-.4 1-1z"/></g></svg>
{{- end -}}
{{- define "personIcon" -}}
<svg class="personIcon" viewBox="0 0 24 24"><path fill="{{ . }}" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4 0-8 2-8 4.5V21h16v-2.5c0-2.5-4-4.5-8-4.5z"/></svg>
{{- end -}}
{{- /*
Two baggage glyphs, not one drawn twice: the passenger reads the difference
between the cabin bag and the checked bag from the shape, before reading the
weight under it. Which one a card gets is the vendor's array position, never a
guess from the weight.
*/ -}}
{{- define "backpackIcon" -}}
<svg class="baggageIcon" viewBox="0 0 24 24"><path fill="{{ . }}" d="M9 2h6a1 1 0 0 1 1 1v1.6A6 6 0 0 1 20 10v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a6 6 0 0 1 4-5.4V3a1 1 0 0 1 1-1zm1 2.1c.3 0 .7-.1 1-.1h2c.3 0 .7 0 1 .1V4h-4v.1zM8 11v3h8v-3H8zm1.5 5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1z"/></svg>
{{- end -}}
{{- define "suitcaseIcon" -}}
<svg class="baggageIcon" viewBox="0 0 24 24"><path fill="{{ . }}" d="M9 2h6a2 2 0 0 1 2 2v2h1a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3h1V4a2 2 0 0 1 2-2zm0 4h6V4H9v2zM8 9v10h1.5V9H8zm6.5 0v10H16V9h-1.5z"/></svg>
{{- end -}}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Bilhete {{ .Locator }}</title>
<style>
  :root {
    --brand: {{ .Brand }};
    --brand-on: {{ .BrandOn }};
    --brand-900: #1B2D8D;
    --neutral-50: #fafafa;
    --neutral-200: #E5E5E5;
    --neutral-300: #d4d4d4;
    --neutral-500: #737373;
    --neutral-600: #525252;
    --neutral-700: #404040;
    --neutral-800: #262626;
    --rail: #daeafb;
    --card: #f5f5f5;
    --seat-placeholder: #d1d5db;
  }

  /* 216mm is the vendor's width; the height comes from the content. The margin
     is what gives the document its breathing room from the paper edge - the
     body adds none of its own on top. */
  @page {
    size: 216mm {{ .PageHeightMM }}mm;
    margin: 12mm 14mm;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 0;
    background: #fff;
    color: var(--neutral-700);
    font-family: "Liberation Sans", Arial, Helvetica, sans-serif;
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  .content { width: 100%; }

  /* ---------------------------------------------------------------- header */

  .header {
    display: table;
    width: 100%;
    padding: 4px 0 10px;
  }
  .headerCell { display: table-cell; vertical-align: middle; }
  .headerCell.logo { width: 150px; }
  .headerCell.info { text-align: right; }

  /* The airline's colour has to appear somewhere on a document that carries its
     name. The original page put it on the "Visualizar reserva" button, which is
     a control and has no place on a passenger's copy - so it becomes a rule
     under the header instead. */
  .brandRule { height: 2px; background: var(--brand); border-radius: 2px; margin-bottom: 14px; }

  .airlineLogoImage { height: 30px; max-width: 150px; }
  .airlineNameFallback { font-size: 15px; font-weight: bold; color: var(--brand-900); }

  .infoItem { display: inline-block; padding: 0 18px; text-align: center; }
  .infoLabel { display: block; font-size: 11px; color: var(--brand-900); }
  .infoValue { display: block; font-size: 15px; font-weight: bold; letter-spacing: -0.01em; }

  /* --------------------------------------------------------------- journey */

  /* page-break-inside is the print-only property that matters most here: a
     journey split across two pages puts the departure on one sheet and the
     arrival on the next. It is the guard that makes a page height estimated
     slightly short degrade into white space rather than into a cut card. */
  .journeySection {
    border: 1px solid var(--neutral-300);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
    page-break-inside: avoid;
  }

  /* The original bar is a hardcoded navy (#152656) on every airline, because
     that page never receives the airline's colour at all - a gap in it, not a
     decision. Here the bar carries the real brand, with the text colour picked
     against it: white fails contrast on GOL's orange and AZUL's light blue. */
  .journeyHeader {
    display: table;
    width: 100%;
    background: var(--brand);
    color: var(--brand-on);
    padding: 7px 18px;
  }
  .journeyHeaderCell { display: table-cell; vertical-align: middle; }
  .journeyTitle { width: 110px; font-size: 14px; font-weight: bold; text-transform: uppercase; }
  .journeyDate { text-align: center; font-size: 14px; font-weight: 500; }
  .journeyLegs { width: 110px; text-align: right; }
  .legsBadge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border: 1px solid currentColor;
    border-radius: 10px;
  }

  .flightsList { padding: 10px 14px 12px; }

  /* The padding here is the "everything is glued to the edge" fix: the card was
     11px/7px, which at this type size reads as text touching a border. */
  .flightSegmentCard {
    background: var(--neutral-50);
    border: 1px solid var(--neutral-300);
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 7px;
  }
  .flightSegmentCard:last-child { margin-bottom: 0; }

  /* The five columns of the original grid, as a table. minmax() has no table
     equivalent, so the two ends get an explicit percentage and the middle its
     fixed width - which reproduces the same result: the route stays centred
     regardless of how long the airport names are. */
  .flightDetails { display: table; width: 100%; }
  .flightCell { display: table-cell; vertical-align: middle; }
  .flightCell.departure { width: 32%; }
  .flightCell.arrival { width: 32%; text-align: right; }
  .flightCell.route { width: 175px; text-align: center; padding: 0 10px; }
  .flightCell.dash { width: 14px; }

  .routeDash {
    display: block;
    width: 14px;
    height: 2px;
    background: var(--neutral-300);
    border-radius: 2px;
  }

  .time { display: block; font-size: 24px; font-weight: bold; color: var(--neutral-600); }
  .date { display: block; font-size: 11px; color: var(--neutral-700); }
  .airportLine { display: block; font-size: 12px; color: var(--neutral-700); }

  .routeCodes { font-size: 19px; font-weight: bold; color: var(--neutral-600); }
  /* Both plane markers are inline SVG, not glyphs: the pdf-service container
     ships only fonts-liberation, which has no U+2708 and no triangles - a
     character reference there renders as a blank gap. */
  .routePlane { width: 16px; height: 16px; vertical-align: -2px; margin: 0 6px; }
  .planeIcon { width: 15px; height: 15px; vertical-align: -3px; margin-right: 5px; }
  .flightMeta { margin-top: 3px; font-size: 12px; }
  .cabinBadge {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 10px;
    border-radius: 7px;
    border: 1px solid var(--brand);
    color: var(--brand);
    font-size: 11px;
  }

  /* ------------------------------------------------------------ passengers */

  .passengersTitle { font-size: 12px; font-weight: 600; margin: 16px 0 7px; letter-spacing: -0.01em; }

  .passengerCard {
    background: var(--card);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 10px;
    page-break-inside: avoid;
  }
  .passengerName {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .personIcon { width: 14px; height: 14px; vertical-align: -2px; margin-right: 6px; }

  /* border-spacing also applies to the outer edges, so the negative margin has
     to compensate on BOTH sides. With it only on the left, a round trip pushed
     the second card past the right edge of the paper and the PDF clipped the
     baggage column clean off. */
  .tripRow { display: table; width: 100%; border-spacing: 10px 0; margin: 0 -10px; }
  .tripCard {
    display: table-cell;
    width: 50%;
    background: #fff;
    border: 1px solid var(--neutral-200);
    border-radius: 12px;
    vertical-align: top;
  }
  /* table-layout: fixed so the declared column widths are honoured. With auto
     layout the browser reallocates by content and hands the baggage column more
     than it asked for, squeezing the seat chips onto a second line. */
  .tripInner { display: table; width: 100%; table-layout: fixed; }
  .tripCellRail {
    display: table-cell;
    /* 40px of text with 4px of breathing room, not 34 with 7: under
       table-layout: fixed the column is exactly what it declares, and "Volta"
       does not fit in 34. */
    width: 40px;
    background: var(--rail);
    padding: 8px 4px;
    border-right: 1px solid var(--neutral-200);
    font-size: 11px;
    font-weight: 500;
    text-align: center;
    vertical-align: middle;
  }
  .railPlane { display: block; width: 14px; height: 14px; margin: 4px auto 0; }
  .tripCellSeats { display: table-cell; padding: 8px 14px; vertical-align: middle; }
  /* 130px, sized to the widest thing that can land here: two entitlements whose
     labels are words ("Mão", "Despachada") rather than short weights. A
     percentage cannot do this job - it is a share of a card that is full width
     on a one-way ticket and half width on a round trip, so the share that fits
     one wraps the other. */
  .tripCellBaggage {
    display: table-cell;
    width: 130px;
    padding: 8px 10px;
    border-left: 1px solid var(--neutral-300);
    vertical-align: middle;
  }

  .seatsLabel, .baggageLabel { font-size: 12px; font-weight: 500; margin-bottom: 3px; }
  .seatItem { display: inline-block; padding: 0 7px; border-right: 1px solid var(--neutral-300); }
  .seatItem:last-child { border-right: 0; }
  .trechoLabel { display: block; font-size: 10px; font-weight: 500; color: var(--neutral-500); }
  .seatValue { display: block; font-size: 13px; font-weight: 600; color: var(--neutral-600); }
  .seatValue.placeholder { color: var(--seat-placeholder); font-weight: 400; }
  /* One entitlement per box, laid out side by side. The boxes are inline-block
     rather than table cells because a direction has one or two of them and they
     should sit next to each other at their own width, not split the column. */
  .baggageItem {
    display: inline-block;
    padding: 0 6px 0 0;
    margin-right: 4px;
    /* The label is a weight ("23kg") on most airlines and a word ("Despachada")
       on the ones that send no weight. Without this the longer word wraps and
       the two entitlements stack instead of sitting side by side. */
    white-space: nowrap;
    border-right: 1px solid var(--neutral-300);
    text-align: center;
    vertical-align: top;
  }
  .baggageItem:last-child { border-right: 0; margin-right: 0; padding-right: 0; }
  .baggageIcon { display: inline-block; width: 15px; height: 15px; vertical-align: middle; }
  .baggageCount {
    display: inline-block;
    margin-left: 4px;
    font-size: 14px;
    font-weight: 700;
    color: var(--neutral-600);
    vertical-align: middle;
  }
  .baggageWeight { display: block; font-size: 9px; color: var(--neutral-500); }

  /* ----------------------------------------------------------- informações */

  .informacoes { margin-top: 16px; font-size: 11px; color: var(--neutral-700); }
  .informacoesTitle { font-size: 12px; font-weight: 600; margin-bottom: 5px; }
</style>
</head>
<body>
<div class="content">

  <div class="header">
    <div class="headerCell logo">
      {{ if .AirlineLogo }}{{ .AirlineLogo }}{{ else }}<span class="airlineNameFallback">{{ .AirlineName }}</span>{{ end }}
    </div>
    <div class="headerCell info">
      {{ if .PurchaseNumber }}
      <span class="infoItem">
        <span class="infoLabel">Número da compra</span>
        <span class="infoValue">{{ .PurchaseNumber }}</span>
      </span>
      {{ end }}
      <span class="infoItem">
        <span class="infoLabel">Localizador</span>
        <span class="infoValue">{{ .Locator }}</span>
      </span>
    </div>
  </div>
  <div class="brandRule"></div>

  {{ $brand := .Brand }}
  {{ $brandOn := .BrandOn }}
  {{ range .Journeys }}
  <div class="journeySection">
    <div class="journeyHeader">
      <div class="journeyHeaderCell journeyTitle">{{ template "planeIcon" dict "Class" "planeIcon" "Colour" $brandOn "Inbound" .Inbound }} {{ .Title }}</div>
      <div class="journeyHeaderCell journeyDate">{{ .Date }}</div>
      <div class="journeyHeaderCell journeyLegs"><span class="legsBadge">{{ .LegLabel }}</span></div>
    </div>
    <div class="flightsList">
      {{ range .Segments }}
      <div class="flightSegmentCard">
        <div class="flightDetails">
          <div class="flightCell departure">
            <span class="time">{{ .DepartureTime }}</span>
            <span class="date">{{ .DepartureDate }}</span>
            <span class="airportLine">{{ .DepartureName }}</span>
          </div>
          <div class="flightCell dash"><span class="routeDash"></span></div>
          <div class="flightCell route">
            <div class="routeCodes">{{ .OriginCode }}{{ template "planeIcon" dict "Class" "routePlane" "Colour" "#525252" "Inbound" false }}{{ .DestinationCode }}</div>
            <div class="flightMeta">
              {{ if .FlightNumber }}Voo <strong>{{ .FlightNumber }}</strong>{{ end }}
              {{ if .Cabin }}<span class="cabinBadge">{{ .Cabin }}</span>{{ end }}
            </div>
          </div>
          <div class="flightCell dash"><span class="routeDash"></span></div>
          <div class="flightCell arrival">
            <span class="airportLine">{{ .ArrivalName }}</span>
            <span class="time">{{ .ArrivalTime }}</span>
            <span class="date">{{ .ArrivalDate }}</span>
          </div>
        </div>
      </div>
      {{ end }}
    </div>
  </div>
  {{ end }}

  {{ if .Passengers }}
  <div class="passengersTitle">{{ pluralize (len .Passengers) "Passageiro" "Passageiros" }}</div>
  {{ range .Passengers }}
  <div class="passengerCard">
    <div class="passengerName">{{ template "personIcon" "#525252" }}{{ .Name }}</div>
    <div class="tripRow">
      {{ range .Trips }}
      <div class="tripCard">
        <div class="tripInner">
          <div class="tripCellRail">
            {{ .Label }}
            {{ template "planeIcon" dict "Class" "railPlane" "Colour" $brand "Inbound" .Inbound }}
          </div>
          <div class="tripCellSeats">
            <div class="seatsLabel">Assentos</div>
            {{ range .Seats }}
            <span class="seatItem">
              <span class="trechoLabel">{{ .Label }}</span>
              <span class="seatValue{{ if not .Assigned }} placeholder{{ end }}">{{ .Value }}</span>
            </span>
            {{ end }}
          </div>
          <div class="tripCellBaggage">
            <div class="baggageLabel">Bagagens</div>
            {{ range .Baggage }}
            <span class="baggageItem">
              {{ if .CarryOn }}{{ template "backpackIcon" $brand }}{{ else }}{{ template "suitcaseIcon" $brand }}{{ end }}
              <span class="baggageCount">{{ .Quantity }}</span>
              <span class="baggageWeight">{{ .Label }}</span>
            </span>
            {{ end }}
          </div>
        </div>
      </div>
      {{ end }}
    </div>
  </div>
  {{ end }}
  {{ end }}

  <div class="informacoes">
    <div class="informacoesTitle">Informações</div>
    <div>Item pessoal incluso. Confira as regras de bagagem e o horário de apresentação no aeroporto com a companhia aérea.</div>
  </div>

</div>
</body>
</html>
